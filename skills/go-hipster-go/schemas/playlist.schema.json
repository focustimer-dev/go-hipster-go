{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/focustimer-dev/hipster-music-generator/blob/main/schemas/playlist.schema.json",
  "title": "Hipster Music Generator Playlist v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "mode",
    "title",
    "concept",
    "sonic_thesis",
    "tracks"
  ],
  "properties": {
    "format_version": {
      "const": "1.0"
    },
    "mode": {
      "enum": [
        "standard",
        "debarge-protocol"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "concept": {
      "type": "string",
      "minLength": 1
    },
    "sonic_thesis": {
      "type": "string",
      "minLength": 1
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "position",
          "artist",
          "title",
          "verification"
        ],
        "properties": {
          "position": {
            "type": "integer",
            "minimum": 1
          },
          "artist": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "scene": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "verified",
                  "unverified"
                ]
              },
              "source_url": {
                "type": "string",
                "format": "uri"
              },
              "note": {
                "type": "string"
              }
            }
          },
          "matches": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "spotify_uri": {
                "type": "string",
                "pattern": "^spotify:track:"
              },
              "youtube_video_id": {
                "type": "string",
                "minLength": 1
              },
              "apple_music_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "publishing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "youtube",
            "spotify",
            "apple-music"
          ]
        },
        "status": {
          "enum": [
            "not_attempted",
            "dry_run",
            "published",
            "failed"
          ]
        },
        "playlist_url": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
