<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_chaos_roll_bg"
    android:contentDescription="Chaos Roll. Generate a twelve-track brief and copy it.">
    <ImageView
        android:id="@+id/chaos_roll_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_cassette_wide3"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:contentDescription="" />
    <TextView
        android:id="@+id/chaos_roll_open"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|right"
        android:gravity="center"
        android:background="#D5121A22"
        android:text="GO"
        android:textColor="#FCECD4"
        android:textSize="12sp"
        android:textStyle="bold"
        android:contentDescription="Open Go, Hipster, Go! app" />
    <TextView
        android:id="@+id/chaos_roll_title"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_gravity="top|left"
        android:gravity="center"
        android:paddingLeft="9dp"
        android:paddingRight="9dp"
        android:background="#DD101A25"
        android:text="CHAOS ROLL"
        android:textColor="#FFF4E0"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed"/>
    <TextView
        android:id="@+id/chaos_roll_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="#D6131C27"
        android:text="12 TRACKS"
        android:textColor="#FFF4E0"
        android:textSize="10sp"
        android:textStyle="bold"
        android:fontFamily="monospace" />
</FrameLayout>
